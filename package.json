{
  "name": "@mmutils/form-validation",
  "version": "0.0.0",
  "description": "One field schema for the browser and the server: typed fields (text, multiline, select, e-mail…) checked in stages with the same code on both sides, live messages in the form, and test cases generated for every form.",
  "keywords": [
    "form",
    "validation",
    "validator",
    "schema",
    "isomorphic",
    "browser",
    "server",
    "typescript",
    "mmutils"
  ],
  "author": "Tihomir Trifonov",
  "license": "MIT",
  "type": "module",
  "main": "./dist/cjs/index.cjs",
  "module": "./dist/esm/index.js",
  "types": "./dist/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/esm/index.js",
      "require": "./dist/cjs/index.cjs"
    },
    "./dom": {
      "types": "./dist/types/dom/index.d.ts",
      "import": "./dist/esm/dom/index.js",
      "require": "./dist/cjs/dom/index.cjs"
    },
    "./testing": {
      "types": "./dist/types/testing/index.d.ts",
      "import": "./dist/esm/testing/index.js",
      "require": "./dist/cjs/testing/index.cjs"
    },
    "./css": {
      "types": "./dist/types/css/index.d.ts",
      "import": "./dist/esm/css/index.js",
      "require": "./dist/cjs/css/index.cjs"
    },
    "./gates": {
      "types": "./dist/types/gates/index.d.ts",
      "import": "./dist/esm/gates/index.js",
      "require": "./dist/cjs/gates/index.cjs"
    },
    "./looks/*": "./dist/looks/*",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "CHANGELOG.md"
  ],
  "sideEffects": [
    "*.css"
  ],
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "npm run clean && rollup -c && tsc -p tsconfig.build.json && node scripts/build-looks.js",
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm test",
    "prepublishOnly": "npm run check && npm run build",
    "examples": "npm run build && node examples/server.js"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.65.0",
    "@rollup/plugin-typescript": "^12.3.0",
    "@types/node": "^22.20.5",
    "@vitest/coverage-v8": "^5.0.5",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.13.0",
    "happy-dom": "^21.0.4",
    "prettier": "^3.9.10",
    "rollup": "^4.64.12",
    "tslib": "^2.8.1",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.0",
    "vitest": "^5.0.5"
  }
}
